generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// CARRERAS — catálogo de las 6 carreras técnicas de INCA EDUCA
// ---------------------------------------------------------------------------
model Carrera {
  id              String       @id @default(uuid())
  nombre          String
  slug            String       @unique
  duracionMeses   Int          @map("duracion_meses")
  imagenUrl       String?      @map("imagen_url")
  descripcionCorta String?     @map("descripcion_corta")
  creadoEn        DateTime     @default(now()) @map("creado_en")

  postulantes     Postulante[]

  @@map("carreras")
}

// ---------------------------------------------------------------------------
// POSTULANTES — todo el que llena el formulario, vía web o chatbot
// ---------------------------------------------------------------------------
enum OrigenPostulante {
  formulario
  chatbot
}

enum EstadoPostulante {
  nuevo
  contactado
  en_seguimiento
  matriculado
  descartado
}

model Postulante {
  id                    String            @id @default(uuid())
  nombreApellido        String            @map("nombre_apellido")
  dni                   String            @db.VarChar(8)
  celular               String            @db.VarChar(9)
  carreraId             String            @map("carrera_id")
  carrera               Carrera           @relation(fields: [carreraId], references: [id])
  estado                EstadoPostulante  @default(nuevo)
  origen                OrigenPostulante
  consentimientoDatos   Boolean           @default(false) @map("consentimiento_datos")
  fechaRegistro         DateTime          @default(now()) @map("fecha_registro")

  conversacion          Conversacion?
  seguimientos          Seguimiento[]

  @@map("postulantes")
}

// ---------------------------------------------------------------------------
// CONVERSACIONES — solo se crea cuando el postulante pide hablar con un asesor
// ---------------------------------------------------------------------------
enum EstadoConversacion {
  activa
  escalada
  cerrada
}

model Conversacion {
  id                  String              @id @default(uuid())
  postulanteId        String              @unique @map("postulante_id")
  postulante          Postulante          @relation(fields: [postulanteId], references: [id])
  estado              EstadoConversacion  @default(escalada)
  fechaEscalamiento   DateTime            @default(now()) @map("fecha_escalamiento")

  mensajes            Mensaje[]

  @@map("conversaciones")
}

// ---------------------------------------------------------------------------
// MENSAJES — historial de una conversación escalada (texto o audio)
// ---------------------------------------------------------------------------
enum RemitenteMensaje {
  postulante
  agente
}

enum TipoMensaje {
  texto
  audio
}

model Mensaje {
  id               String            @id @default(uuid())
  conversacionId   String            @map("conversacion_id")
  conversacion     Conversacion      @relation(fields: [conversacionId], references: [id])
  remitente        RemitenteMensaje
  tipo             TipoMensaje       @default(texto)
  contenido        String            @db.Text
  enviadoEn        DateTime          @default(now()) @map("enviado_en")

  @@map("mensajes")
}

// ---------------------------------------------------------------------------
// SEGUIMIENTOS — registro de cada mensaje automático/manual de seguimiento
// ---------------------------------------------------------------------------
enum CanalSeguimiento {
  whatsapp
  correo
}

enum EstadoSeguimiento {
  enviado
  fallido
  reintentando
}

model Seguimiento {
  id             String             @id @default(uuid())
  postulanteId   String             @map("postulante_id")
  postulante     Postulante         @relation(fields: [postulanteId], references: [id])
  adminId        String?            @map("admin_id")
  admin          Admin?             @relation(fields: [adminId], references: [id])
  canal          CanalSeguimiento
  estado         EstadoSeguimiento  @default(enviado)
  fechaEnvio     DateTime           @default(now()) @map("fecha_envio")

  @@map("seguimientos")
}
// ---------------------------------------------------------------------------
// SESIONES WHATSAPP — historial temporal de conversaciones del bot de FAQ
// ---------------------------------------------------------------------------
model SesionWhatsapp {
  id              String   @id @default(uuid())
  telefono        String   @unique
  historial       Json
  ultimaActividad DateTime @default(now()) @map("ultima_actividad")

  @@map("sesiones_whatsapp")
}

// ---------------------------------------------------------------------------
// GALERIA — fotos y videos de eventos institucionales
// ---------------------------------------------------------------------------
enum TipoGaleria {
  foto
  video
}

// Categoría institucional de la publicación (para el filtro de la galería
// pública). Opcional/nullable a propósito: las filas ya existentes no tienen
// categoría asignada todavía y no deben romperse con esta migración.
enum CategoriaGaleria {
  actividades_academicas
  talleres_practicas
  eventos_institucionales
  nuestros_espacios
}

model Galeria {
  id            String            @id @default(uuid())
  tipo          TipoGaleria
  categoria     CategoriaGaleria?
  url           String
  titulo        String
  evento        String
  // Controla si aparece en la Galería pública (sin borrar el registro).
  activo        Boolean           @default(true)
  // Aparece en el carrusel "Momentos que quedan" de la Galería pública.
  destacado     Boolean           @default(false)
  // Orden manual dentro de su carrusel (menor = primero). Los registros
  // existentes quedan en 0 y se ordenan luego por fecha de subida.
  orden         Int               @default(0)
  adminId       String            @map("admin_id")
  admin         Admin             @relation(fields: [adminId], references: [id])
  fechaSubida   DateTime          @default(now()) @map("fecha_subida")

  @@map("galeria")
}

// ---------------------------------------------------------------------------
// CONTACTOS — mensajes enviados desde el formulario público de /contacto
// ---------------------------------------------------------------------------
enum EstadoContacto {
  nuevo
  atendido
}

model Contacto {
  id          String          @id @default(uuid())
  nombre      String
  correo      String
  telefono    String          @db.VarChar(9)
  // Texto libre proveniente de MOTIVOS_CONSULTA en frontend/lib/contacto.ts
  // (no es un enum a propósito: son etiquetas de UI en español, no códigos).
  motivo      String
  mensaje     String          @db.Text
  estado      EstadoContacto  @default(nuevo)
  creadoEn    DateTime        @default(now()) @map("creado_en")

  @@map("contactos")
}

// ---------------------------------------------------------------------------
// ADMINS — único rol administrativo (admin = asesor)
// ---------------------------------------------------------------------------
model Admin {
  id             String          @id @default(uuid())
  nombre         String
  email          String          @unique
  passwordHash   String          @map("password_hash")
  creadoEn       DateTime        @default(now()) @map("creado_en")

  seguimientos   Seguimiento[]
  galeria        Galeria[]

  @@map("admins")
}
